# Gateway remains loopback-only. Do not change this to 0.0.0.0 for public exposure.
HARU_MCP_HOST=127.0.0.1
HARU_MCP_PORT=8765
HARU_MCP_PATH=/mcp

# Isolated loopback MCP backends. Adapt ports if your local backend layout differs.
HARU_MCP_WORKSPACE_FILESYSTEM_URL=http://127.0.0.1:8766/servers/filesystem/mcp
HARU_MCP_WORKSPACE_SHELL_URL=http://127.0.0.1:8766/servers/shell/mcp

# Optional transport allowlist for an authenticated reverse proxy/tunnel.
# These values ONLY control Host/Origin validation; they are not authentication.
# HARU_MCP_PUBLIC_HOST=mcp.example.com
# HARU_MCP_PUBLIC_ORIGIN=https://mcp.example.com
