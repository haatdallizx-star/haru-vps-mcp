+// Apple exposes background delivery as part of the HealthKit capability rather
+// than as a capability of its own, so this maps onto the same capability type.
+// Without an entry here the entitlement is unrecognized, which means free teams
+// silently lose it: DeveloperServicesAddAppOperation rebuilds `Entitlements`
+// from the recognized list only.
+extension HealthKitBackgroundDeliveryEntitlement: EntitlementWithCapability {
+    var capability: DeveloperServicesCapability {
+        DeveloperServicesCapability(.healthkit, isFree: true)
+    }
+}
